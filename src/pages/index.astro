---
// 语言入口页：按浏览器语言跳转到 /en/ 或 /zh/，并为爬虫提供 canonical、hreflang 与可点击兜底链接
const site = Astro.site ?? new URL('https://feberes.com');
const base = import.meta.env.BASE_URL;
const enUrl = new URL('/en/', site).href;
const zhUrl = new URL('/zh/', site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Feberes — Chemical Fiber Yarn Manufacturer &amp; Exporter</title>
    <meta name="description" content="Hebei Feberes Chemical Fiber Materials Co., Ltd. — chemical fiber yarn manufacturer and exporter. 河北菲泊丝化纤材料有限公司，化纤长丝与纱线出口制造商。" />
    <link rel="canonical" href={enUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script is:inline define:vars={{ base }}>
      (function () {
        var lang = null;
        try {
          lang = localStorage.getItem('feberes-lang');
        } catch (e) {}
        if (lang !== 'en' && lang !== 'zh') {
          var nav = (navigator.language || 'en').toLowerCase();
          lang = nav.indexOf('zh') === 0 ? 'zh' : 'en';
        }
        location.replace(base + lang + '/');
      })();
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/en/" /></noscript>
  </head>
  <body style="font-family:system-ui,-apple-system,'Segoe UI','Microsoft YaHei',sans-serif;padding:40px;color:#0a2540">
    <p>
      <a href={`${base}en/`}>English</a> &nbsp;·&nbsp; <a href={`${base}zh/`}>中文</a>
    </p>
  </body>
</html>
